  "narrative": {
    "northStar": "Quiet rhythm",
    "overview": "A quiet running order makes daily attendance easy to scan and record. Full course names, a narrow period/time rail, open rows, and a small set of outline icons carry the interface. Blue identifies action and selection against neutral light or charcoal dark surfaces.\n\nThe owner-pinned character is minimal, clean, uncluttered, and icon-led. Supporting text appears when it changes a decision: provisional credit, missing records, recovery requirements, and destructive confirmations remain explicit. There is no decorative imagery, wallpaper-derived color, or purple/lavender surface language.",
    "keyCharacteristics": [
      "Open time-led rows rather than repeated dashboard cards.",
      "Bundled Manrope with tabular numerals and compact hierarchy.",
      "Restrained blue, neutral groups, and semantic error color in both themes.",
      "Named icon actions; short text for primary and consequential actions."
    ],
    "rules": [
      {
        "name": "The Pinned Palette Rule",
        "body": "Use the explicit light or dark scheme. System mode chooses the scheme; wallpaper colors never replace it.",
        "section": "colors"
      },
      {
        "name": "The Useful Color Rule",
        "body": "Blue marks action, selection, focus, or recorded progress. Error colors mark absence, rejection, validation, missing records, or a course below its minimum. Pending credit stays neutral and named.",
        "section": "colors"
      },
      {
        "name": "The Clear State Rule",
        "body": "Keep full course names and concise uncertainty labels. Icons reduce repeated copy; they do not erase provisional or consequential meaning.",
        "section": "typography"
      },
      {
        "name": "The Tonal Group Rule",
        "body": "Use open rows for running lists and neutral surface groups where settings, calendar content, or review data need a boundary. Do not turn every row into a bordered card.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the pinned light and dark schemes and the shared Manrope hierarchy.",
      "Do keep full course names, period-based counts, and short provisional or incomplete-state labels.",
      "Do use the authored outline vectors and supply an accessible name for each icon action.",
      "Do retain concise text on the primary action and on save, cancel, restore, and destructive decisions.",
      "Do reuse open rows, the time rail, tonal grouping, and native Material interaction behavior.",
      "Do validate new layouts on the target device; source adaptations are not proof of tablet, enlarged-text, or TalkBack behavior."
    ],
    "donts": [
      "Don't introduce wallpaper dynamic color, purple/lavender surfaces, or additional decorative accents.",
      "Don't add explanatory paragraphs, decorative imagery, ornamental progress, or repeated bordered dashboard cards.",
      "Don't replace authored vectors with text glyphs, emoji, or icon fonts.",
      "Don't make pending credit look confirmed or hide missing-record and below-minimum states to simplify a screen.",
      "Don't treat documentation HTML previews as app code or pixel-accurate native renders."
    ]
  }
}
