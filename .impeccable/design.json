      "html": "<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"Periods recorded\" aria-valuemin=\"0\" aria-valuemax=\"6\" aria-valuenow=\"3\"><span class=\"ds-done\"></span><span class=\"ds-done\"></span><span class=\"ds-done\"></span><span class=\"ds-remaining\"></span><span class=\"ds-remaining\"></span><span class=\"ds-remaining\"></span></div>",
