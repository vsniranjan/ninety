      "html": "<nav class=\"ds-nav\" aria-label=\"Main\"><div role=\"tablist\"><button class=\"ds-tab ds-selected\" role=\"tab\" aria-selected=\"true\" aria-label=\"Today\"><span class=\"ds-tab-icon\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8,3v4 M16,3v4 M4,9h16 M6,5h12a2,2 0,0 1,2 2v12a2,2 0,0 1,-2 2H6a2,2 0,0 1,-2 -2V7a2,2 0,0 1,2 -2 M8,14l2.5,2.5L16,11\"/></svg></span><span class=\"ds-tab-label\">Today</span></button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" aria-label=\"Courses\"><span class=\"ds-tab-icon\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4,5.5c3,-1.2 5,-0.8 8,1c3,-1.8 5,-2.2 8,-1v14c-3,-1.2 -5,-0.8 -8,1c-3,-1.8 -5,-2.2 -8,-1z M12,6.5v14\"/></svg></span></button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" aria-label=\"History\"><span class=\"ds-tab-icon\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3,11a9,9 0,1 1,2.5 7 M3,4v7h7 M12,7v5l3,2\"/></svg></span></button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" aria-label=\"Duty Leave\"><span class=\"ds-tab-icon\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8,3h8v4H8z M8,5H6a2,2 0,0 0,-2 2v13h16V7a2,2 0,0 0,-2 -2h-2 M8,13l2.5,2.5L16,10\"/></svg></span></button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\" aria-label=\"Settings\"><span class=\"ds-tab-icon\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4,6h7 M15,6h5 M4,12h2 M10,12h10 M4,18h10 M18,18h2 M11,3v6 M6,9v6 M14,15v6\"/></svg></span></button></div></nav>",
      "css": ".ds-nav{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";width:100%;max-width:440px;background:#F7F8FA}.ds-nav>div{display:flex;height:72px}.ds-tab{display:flex;flex:1;min-width:0;flex-direction:column;align-items:center;gap:4px;padding:12px 0 0;border:0;background:transparent;color:#626975;cursor:pointer}.ds-tab-icon{display:flex;align-items:center;justify-content:center;width:56px;max-width:100%;height:32px;border-radius:10px}.ds-selected .ds-tab-icon{background:#E8EEFC;color:#173C91}.ds-tab-label{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";color:#17191D;font-size:12px;font-weight:500;line-height:18px}.ds-tab:hover .ds-tab-icon{background:#EFF1F4}.ds-tab:focus-visible{outline:0}.ds-tab:focus-visible .ds-tab-icon{outline:1px solid #2457D6}.ds-tab:active .ds-tab-icon{background:#E3E6EB}@media(prefers-color-scheme:dark){.ds-nav{background:#101113}.ds-tab{color:#A5ACB8}.ds-tab-label{color:#F3F4F6}.ds-selected .ds-tab-icon{background:#243653;color:#DCE6FF}.ds-tab:hover .ds-tab-icon,.ds-tab:active .ds-tab-icon{background:#25282E}.ds-tab:focus-visible .ds-tab-icon{outline-color:#8AACFF}}"
