  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "primary-action-light",
      "description": "Documentation translation only: CSS px illustrate native dp/sp; browser Manrope availability and web states are not Android rendering guarantees. PrimaryAction in Components.kt: minimum 52dp, medium shape, native Material enabled/disabled feedback.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5,12l4.5,4.5L19,7\"/></svg><span>Mark all present</span></button>",
      "css": ".ds-primary{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:14px 20px;border:0;border-radius:12px;background:#2457D6;color:#FFFFFF;font-size:14px;font-weight:600;line-height:20px;cursor:pointer}.ds-primary:hover{filter:brightness(.96)}.ds-primary:focus-visible{outline:2px solid #2457D6;outline-offset:3px}.ds-primary:active{filter:brightness(.90)}.ds-primary:disabled{opacity:.38;cursor:default}@media(prefers-color-scheme:dark){.ds-primary{background:#8AACFF;color:#102654}.ds-primary:focus-visible{outline-color:#8AACFF}}"
    },
    {
      "name": "Text action",
      "kind": "button",
      "refersTo": "text-button-light",
      "description": "Documentation translation only: CSS px illustrate native dp/sp; browser Manrope availability and web states are not Android rendering guarantees. Material TextButton used for Save/Cancel and secondary actions; native metrics are framework-owned.",
      "html": "<button class=\"ds-text\">Save</button>",
      "css": ".ds-text{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";padding:10px 12px;border:0;border-radius:12px;background:transparent;color:#2457D6;font-size:14px;font-weight:600;line-height:20px;cursor:pointer}.ds-text:hover{background:#E8EEFC}.ds-text:focus-visible{outline:2px solid currentColor;outline-offset:2px}.ds-text:active{background:#E8EEFC}.ds-text:disabled{opacity:.38}@media(prefers-color-scheme:dark){.ds-text{color:#8AACFF}.ds-text:hover,.ds-text:active{background:#243653}}"
    },
    {
      "name": "Icon action",
      "kind": "button",
      "refersTo": "icon-action",
      "description": "Documentation translation only: CSS px illustrate native dp/sp; browser Manrope availability and web states are not Android rendering guarantees. ActionIcon in Components.kt: named 48dp target, 22dp authored vector, native tooltip; source disabled tint alpha is 0.38.",
      "html": "<button class=\"ds-icon\" aria-label=\"Day actions\" title=\"Day actions\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12,5h0.01 M12,12h0.01 M12,19h0.01\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:48px;height:48px;padding:0;border:0;border-radius:50%;background:transparent;color:#626975;cursor:pointer}.ds-icon:hover{background:#EFF1F4}.ds-icon:focus-visible{outline:2px solid #2457D6;outline-offset:2px}.ds-icon:active{background:#E3E6EB}.ds-icon:disabled{opacity:.38}@media(prefers-color-scheme:dark){.ds-icon{color:#A5ACB8}.ds-icon:hover,.ds-icon:active{background:#25282E}.ds-icon:focus-visible{outline-color:#8AACFF}}"
    },
    {
      "name": "Outlined field",
      "kind": "input",
      "refersTo": "outlined-field",
      "description": "Documentation translation only: CSS px illustrate native dp/sp; browser Manrope availability and web states are not Android rendering guarantees. Material OutlinedTextField in CoursesScreen.kt and SetupScreen.kt; native focus/error/shape metrics are inherited, CSS outline is an illustration.",
      "html": "<label class=\"ds-field\"><span>Course name</span><input aria-label=\"Course name\" value=\"Operating Systems\"/></label>",
      "css": ".ds-field{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";display:flex;position:relative;max-width:320px;padding-top:7px;color:#626975;font-size:12px;line-height:18px}.ds-field span{position:absolute;top:0;left:12px;padding:0 4px;background:#FFFFFF}.ds-field input{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";min-width:0;width:100%;padding:16px;border:1px solid #626975;border-radius:8px;background:#FFFFFF;color:#17191D;font-size:16px;line-height:24px}.ds-field input:hover{border-color:#17191D}.ds-field input:focus-visible{outline:2px solid #2457D6;outline-offset:-2px}.ds-field:focus-within span{color:#2457D6}.ds-field input:disabled{opacity:.38}@media(prefers-color-scheme:dark){.ds-field{color:#A5ACB8}.ds-field span,.ds-field input{background:#191B1F}.ds-field input{color:#F3F4F6;border-color:#A5ACB8}.ds-field input:focus-visible{outline-color:#8AACFF}.ds-field:focus-within span{color:#8AACFF}}"
    },
    {
      "name": "Choice chip",
      "kind": "chip",
      "refersTo": "filter-choice",
      "description": "Documentation translation only: CSS px illustrate native dp/sp; browser Manrope availability and web states are not Android rendering guarantees. ChoiceRow/WeeklySchedule use Material FilterChip at minimum 48dp; selected state shown. Native defaults own unselected boundary and shape.",
      "html": "<button class=\"ds-choice\" aria-pressed=\"true\">Monday</button>",
      "css": ".ds-choice{font-family:Manrope,sans-serif;font-feature-settings:\"tnum\";min-height:48px;padding:10px 16px;border:0;border-radius:8px;background:#E8EEFC;color:#173C91;font-size:14px;font-weight:600;line-height:20px;cursor:pointer}.ds-choice:hover{filter:brightness(.97)}.ds-choice:focus-visible{outline:2px solid #2457D6;outline-offset:2px}.ds-choice:active{filter:brightness(.92)}@media(prefers-color-scheme:dark){.ds-choice{background:#243653;color:#DCE6FF}.ds-choice:focus-visible{outline-color:#8AACFF}}"
